---
const title = "CostLens";
const pollMs = 30000;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 14px/1.5 system-ui, sans-serif; padding: 1.5rem; }
      h1 { margin: 0 0 .25rem; }
      h2 { margin: 1.5rem 0 .5rem; font-size: 1.1rem; }
      .muted { color: #888; }
      .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
      .card { border: 1px solid #3333; border-radius: 10px; padding: 1rem; }
      .card .big { font-size: 1.6rem; font-weight: 600; }
      .providers { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; }
      .provider .name { font-weight: 600; }
      .badge { font-size: .7rem; padding: 0 6px; border-radius: 999px; border: 1px solid #3333; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #3332; }
      td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
      .err { color: #d33; }
      .note { color: #a80; }
    </style>
  </head>
  <body>
    <h1>CostLens</h1>
    <p class="muted" id="status">Loading…</p>

    <h2>Totals</h2>
    <div class="cards" id="totals"></div>

    <h2>Most used models</h2>
    <table id="models">
      <thead>
        <tr><th>Model</th><th class="num">Cost</th><th class="num">In</th><th class="num">Out</th><th class="num">Reqs</th></tr>
      </thead>
      <tbody></tbody>
    </table>

    <h2>Providers</h2>
    <div class="providers" id="providers"></div>

    <script define:vars={{ pollMs }}>
      const $ = (id) => document.getElementById(id);
      const fmt = (n) => (n ?? 0).toLocaleString();
      const money = (n) => "$" + (n ?? 0).toFixed(2);

      async function load() {
        try {
          const res = await fetch("/api/usage");
          const data = await res.json();
          render(data);
          $("status").textContent = "Updated " + new Date(data.generatedAt).toLocaleString();
        } catch (e) {
          $("status").textContent = "Error: " + e.message;
        }
      }

      function render(data) {
        const t = data.totals;
        $("totals").innerHTML = `
          <div class="card"><div class="muted">Total cost</div><div class="big">${money(t.cost)}</div></div>
          <div class="card"><div class="muted">Input tokens</div><div class="big">${fmt(t.inputTokens)}</div></div>
          <div class="card"><div class="muted">Output tokens</div><div class="big">${fmt(t.outputTokens)}</div></div>
        `;

        const mbody = $("models").querySelector("tbody");
        mbody.innerHTML = (t.mostUsedModels || []).map((m) => `
          <tr><td>${m.model}</td><td class="num">${money(m.cost)}</td>
          <td class="num">${fmt(m.inputTokens)}</td><td class="num">${fmt(m.outputTokens)}</td>
          <td class="num">${fmt(m.requests)}</td></tr>`).join("") || `<tr><td colspan="5" class="muted">No data</td></tr>`;

        $("providers").innerHTML = (data.providers || []).map((p) => {
          const cls = !p.ok ? "err" : p.note ? "note" : "";
          const badge = !p.ok ? "error" : p.note ? "stub" : "ok";
          const msg = p.error || p.note || `${p.byModel.length} models`;
          return `<div class="card provider">
            <div class="name">${p.name} <span class="badge ${cls}">${badge}</span></div>
            <div class="big">${money(p.totalCost)}</div>
            <div class="${cls}">${msg}</div>
          </div>`;
        }).join("") || `<div class="card muted">No providers enabled</div>`;
      }

      load();
      setInterval(load, pollMs);
    </script>
  </body>
</html>
