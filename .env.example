# Enable providers by setting their credentials. Only enabled (non-empty) ones are queried.
# Copy to .env and fill in the ones you use.

# OpenRouter
OPENROUTER_KEY=

# Groq
GROQ_KEY=

# DeepSeek
DEEPSEEK_KEY=

# Nous
NOUS_KEY=

# OpenCode (token key)
OPENCODE_TOKEN=

# Antigravity (OAuth)
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_REFRESH_TOKEN=

# Server-side cache TTL for provider fetches (ms). Polls within this window
# reuse cached data instead of hitting provider APIs. Default 120000 (2 min).
CACHE_TTL_MS=120000
